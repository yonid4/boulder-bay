# Supabase local stack
supabase/.branches/
supabase/.temp/

# Generated by XcodeGen from app/project.yml alongside the .xcodeproj
app/BoulderBay/Resources/Info.plist

# Supabase URL + anon key for the iOS app — copy Supabase.example.xcconfig
app/Config/Supabase.xcconfig

# Logos
/logos

# xcodebuild output when run without -derivedDataPath
app/build/
