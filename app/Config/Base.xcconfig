// Checked-in defaults keep CI builds reproducible. A developer's ignored local
// file supplies the hosted project values without committing them.
// The Simulator reaches the backend on localhost. A physical device cannot —
// localhost there is the phone — so override this with your Mac's LAN IP in the
// ignored Supabase.xcconfig. The $() stops // being read as a comment.
BB_API_BASE_URL = http:/$()/localhost:8000

BB_SUPABASE_URL =
BB_SUPABASE_ANON_KEY =

#include? "Supabase.xcconfig"
