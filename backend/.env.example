# Copy to `.env` and fill in. `.env` is gitignored — never commit real values.
# Boulder Bay uses a hosted Supabase project; there is no local Postgres fallback,
# so DATABASE_URL and SUPABASE_URL are required and the app fails fast without them.

# Postgres, from Supabase → Project Settings → Database.
# Copy the string the dashboard gives you rather than composing one by hand, then:
#   1. take the SESSION-mode pooler (port 5432) — port 6543 is transaction mode and
#      breaks asyncpg prepared statements; app/config.py rejects it outright.
#   2. replace `postgresql://` with `postgresql+asyncpg://`.
# The non-pooled direct connection is IPv6-only and will not resolve on most networks.
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<db-password>@<host>.pooler.supabase.com:5432/postgres

# Supabase project URL, from Project Settings → API. Used to reach the ES256
# JWKS at {SUPABASE_URL}/auth/v1/.well-known/jwks.json for verifying auth tokens.
SUPABASE_URL=https://<project-ref>.supabase.co

# Optional. The scheduler uses it to send the `poll_finished` Realtime ping on the public
# `polls` channel; left empty, no ping is sent. JWT verification uses the public JWKS, not a
# key. The iOS app holds its own copy.
SUPABASE_ANON_KEY=

# Mapbox Matrix API token, for travel times on the narrowed candidate set.
# Optional: left empty, rankings use the straight-line fallback (6 + miles x 2.3 minutes).
MAPBOX_TOKEN=

# Rankings only consider gyms within this straight-line distance of the chosen place.
# Default 80467 (50 miles), so a far-away place doesn't rank Bay Area gyms at all.
RANKING_RADIUS_METERS=80467

# /health database check. If the database can't be read in time, /health still answers
# 200 and names the cause in its `database` field:
#   unreachable  no connection within HEALTH_CONNECT_TIMEOUT_SECONDS (network, DNS, refused),
#                or no reply at all within HEALTH_TOTAL_TIMEOUT_SECONDS
#   locked       waited longer than HEALTH_LOCK_TIMEOUT_MS for a lock (e.g. a migration)
#   overloaded   the query ran past HEALTH_STATEMENT_TIMEOUT_MS, or too many connections
HEALTH_CONNECT_TIMEOUT_SECONDS=5
HEALTH_LOCK_TIMEOUT_MS=1000
HEALTH_STATEMENT_TIMEOUT_MS=2000
HEALTH_TOTAL_TIMEOUT_SECONDS=8

# Level for the app's own logs (DEBUG, INFO, WARNING or ERROR; any case). The API prints
# them itself, so plain `uvicorn app.main:app` shows each poll tick. DEBUG adds one line per
# scraped gym and the travel-time cache counts.
LOG_LEVEL=INFO

# Ingestion cadence
LIVE_POLL_MINUTES=30
SCRAPE_MAX_ATTEMPTS=6

# Run the poll every :00 and :30 inside the API process (default false, so tests, CI and
# a plain dev server never launch Chromium). Needs full Chromium and the signed-in profile
# below, and uvicorn with ONE worker and no --reload, or each process polls on its own.
SCHEDULER_ENABLED=false

# Chromium profile the scraper signs in to Google with. Signed-out Google Maps hides
# the Popular times chart, so run `uv run python -m app.scrape --login` once and sign
# in. The folder holds a live Google session: keep it outside the repo. Default:
# ~/.boulder-bay/chromium-profile
# SCRAPE_PROFILE_DIR=
